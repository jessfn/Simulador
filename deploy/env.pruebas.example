# backend/.env del SERVIDOR DE PRUEBAS. No copiar nunca los valores de produccion.
DB_HOST=localhost
DB_PORT=5432
DB_USER=simac_qa
DB_PASSWORD=<la que imprime setup-servidor-pruebas.sh>
DB_NAME=bodegas_qa
JWT_SECRET=<generar uno NUEVO: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
PORT=3000
NODE_ENV=staging
# Integraciones externas (RENAPO, SADER, correo, SMS, push): dejar vacias o con llaves de prueba
# para que desde pruebas no se consulten ni notifiquen datos reales.
JOBS_ENABLED=false
