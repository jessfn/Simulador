# Copia este archivo como deploy/deploy.env y llena TUS valores. deploy/deploy.env NO se sube a git (está en .gitignore).
# Aquí no hay ningún valor real a propósito: el repositorio puede ser público.

# ── Ruta del proyecto en los servidores ──
RUTA_PROYECTO=/var/www/Simulador

# ── Ambiente de pruebas (suspendido desde 2026-10-26; se conserva por si se reanuda) ──
PRUEBAS_USUARIO=
PRUEBAS_SERVIDOR=
PRUEBAS_LLAVE=~/.ssh/llave_pruebas

# ── Producción (se llega por un túnel a través del bastión) ──
PROD_BASTION_USUARIO=
# Desde la red de la oficina y desde internet el bastión tiene direcciones distintas: pregunta a TI cuál usar según dónde estés.
PROD_BASTION=
PROD_SERVIDOR_INTERNO=
PROD_USUARIO=
PROD_LLAVE=~/.ssh/llave_produccion
PROD_PUERTO_TUNEL=2223
