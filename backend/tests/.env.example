# Copia este archivo como tests/.env y llénalo. tests/.env NO se sube a git.
# Aquí no hay datos reales: todo lo que pongas debe ser de un ambiente de PRUEBAS.

# Dirección del API del servidor de pruebas (termina en /api)
TEST_API_URL=http://localhost:3000/api

# Dirección de la web (para las pruebas en pantalla). Si la dejas vacía se toma TEST_API_URL sin el /api final.
TEST_WEB_URL=

# Base de datos de PRUEBAS (copia o base vacía con las migraciones aplicadas). El nombre debe contener test, prueba, qa o dev.
TEST_DATABASE_URL=postgres://usuario:clave@localhost:5432/bodegas_test

# Contraseña que tendrán los usuarios ficticios de prueba (invéntala; nunca una contraseña real)
TEST_PASSWORD=
# Contraseña del administrador ficticio (si la dejas vacía se usa TEST_PASSWORD)
TEST_ADMIN_PASSWORD=

# Solo si el servidor de pruebas está en OTRA máquina y quieres correr las pruebas de la tarea de verificación y de "servicios caídos".
# Es el comando que abre una sesión allá (por ejemplo: ssh -i ~/.ssh/mi_llave usuario@servidor). Vacío = el servidor corre en esta misma máquina.
TEST_REMOTE_SHELL=
# Ruta de la carpeta backend en la máquina del servidor de pruebas (solo si TEST_REMOTE_SHELL está lleno)
TEST_BACKEND_DIR=

# Patrones extra (separados por coma) de servidores que NUNCA deben usarse en pruebas, además de los que ya trae la protección
TEST_PROD_PATRONES=
