# Plantilla de configuración del backend.

# ─── BASE DE DATOS ───────────────────────────────────────────────
# Valores del contenedor local simac-db (docker-compose.yml).
# Obligatorias: si quedan vacías el backend no se conecta a la base.
DB_HOST=localhost
DB_PORT=5432
DB_USER=simac_dev
DB_PASSWORD=simac_dev
DB_NAME=bodegas

# ─── AUTENTICACIÓN ───────────────────────────────────────────────
# Firma los tokens de sesión. Obligatoria: si queda vacía el inicio de sesión responde con error.
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cadena_aleatoria_minimo_64_caracteres

# ─── SERVIDOR ────────────────────────────────────────────────────
# Si queda vacía se usa 3000.
PORT=3000
# Con production, los archivos subidos van a /var/www/Simulador/uploads;
# con cualquier otro valor, a uploads/ en la raíz del repositorio.
NODE_ENV=development
# Dirección del frontend para las ligas de los correos (recuperar contraseña).
# Si queda vacía se usa el dominio de producción.
APP_URL=http://localhost:5174

# ─── API SADER (padrón SURI) ─────────────────────────────────────
# URL y llave las proporciona DGTIC.
# Si quedan vacías la consulta al padrón no responde.
SADER_API_URL=
SADER_API_KEY=

# ─── API RENAPO (verificación de CURP) ───────────────────────────
# Token y sesión los proporciona DGTIC (requiere VPN).
# Si quedan vacías la verificación de CURP falla y el registro de productores queda bloqueado.
# Si RENAPO_API_URL queda vacía, el código usa la URL de producción.
RENAPO_API_URL=
RENAPO_API_KEY=
# Cookie suri_session activa; renovar cuando expire.
RENAPO_SESSION=

# ─── BANXICO (tipo de cambio oficial USD/MXN) ────────────────────
# Obtener gratis en: https://www.banxico.org.mx/SieAPIRest/service/v1/token
# Sin este token el tipo de cambio usa Yahoo Finance como respaldo.
BANXICO_TOKEN=

# ─── CORREO (SMTP) ───────────────────────────────────────────────
# Sin SMTP_HOST, SMTP_USER y SMTP_PASS no se envían correos.
SMTP_HOST=
# 587 por defecto; con 465 se usa conexión segura (SSL).
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Nombre del remitente. Si queda vacío se usa "Maíz".
SMTP_FROM_NAME=

# ─── NOTIFICACIONES PUSH (VAPID) ─────────────────────────────────
# Generar con: npx web-push generate-vapid-keys
# Sin llaves no se envían notificaciones push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del emisor. Si queda vacío se usa mailto:simac@agricultura.gob.mx
VAPID_EMAIL=

# ─── BOT DEL CHAT DE AYUDA (Groq) ────────────────────────────────
# Sin llave, o con CHAT_BOT_ENABLED=false, el bot queda apagado.
GROQ_API_KEY=
CHAT_BOT_ENABLED=false

# ─── REGISTRO DE ADMINISTRADORES ─────────────────────────────────
# Código para dar de alta administradores desde la app.
# Si queda vacía ese registro responde con error.
ADMIN_REGISTRO_CODIGO=

# ─── SOLO DESARROLLO: USUARIOS DE PRUEBA ─────────────────────────
# Los usa backend/scripts/crear-usuarios-desarrollo.js.
# Contraseña de admin, bodeguero y capturista (mínimo 8 caracteres).
# Si queda vacía, el script genera una al azar y la muestra.
DEV_USUARIOS_PASSWORD=
# NIP de los productores de prueba (4 dígitos). Si queda vacío, se genera al azar.
DEV_PRODUCTOR_NIP=

# ─── TAREAS PROGRAMADAS ──────────────────────────────────────────
# false = no corre ninguna tarea programada (usar en el ambiente de pruebas).
# Si queda vacía, las tareas quedan activas.
JOBS_ENABLED=true

# ─── VERIFICACIÓN DE IDENTIDAD (solo desarrollo y pruebas) ───────
# true = no consulta SADER ni RENAPO: simula la respuesta según la CURP
# (ver backend/src/services/identidad.ts). Se ignora con NODE_ENV=production.
# Si queda vacía, se consultan los servicios reales.
IDENTIDAD_SIMULADA=false

# ─── LÍMITE DE CONSULTAS DE CURP POR TÉCNICO ─────────────────────
# Máximo de consultas por ventana de minutos. Si quedan vacías: 40 consultas cada 15 minutos.
CONSULTA_CURP_MAX=
CONSULTA_CURP_VENTANA_MIN=
